[Unit]
Description=Load/Save Screen Backlight Brightness of %i
Documentation=man:systemd-backlight@.service(8)
DefaultDependencies=no
Conflicts=shutdown.target
After=lxc@android.service android-service@hwcomposer.service boot-completed.service
Requires=boot-completed.service
Before=shutdown.target
ConditionPathExists=!/system-update

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/systemd/systemd-backlight load %i
ExecStop=/usr/share/furios-quirks/brightness/furios-save-brightness.sh save %i
TimeoutSec=90s
StateDirectory=systemd/backlight

[Install]
WantedBy=graphical.target
